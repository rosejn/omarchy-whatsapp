#!/usr/bin/env python3
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk

dialog = Gtk.FileChooserDialog(
    title="Attach file to WhatsApp",
    action=Gtk.FileChooserAction.OPEN,
    buttons=("Cancel", Gtk.ResponseType.CANCEL, "Attach", Gtk.ResponseType.ACCEPT),
)
dialog.set_modal(True)
dialog.set_select_multiple(False)

audio_files = Gtk.FileFilter()
audio_files.set_name("Audio files")
for pattern in ("*.aac", "*.flac", "*.m4a", "*.mp3", "*.oga", "*.ogg", "*.opus", "*.wav"):
    audio_files.add_pattern(pattern)
dialog.add_filter(audio_files)

response = dialog.run()
if response == Gtk.ResponseType.ACCEPT:
    print(dialog.get_filename())
dialog.destroy()
